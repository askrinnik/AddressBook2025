{
  "name": "addressbook-api-tests",
  "version": "1.0.0",
  "description": "Modern API E2E test framework for AddressBook.Api (Playwright + TypeScript)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright test && playwright show-report",
    "test:remote": "cross-env BASE_URL=https://addressbook-api-h5gmdghdcyfaf6gu.westeurope-01.azurewebsites.net/api/ playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\""
  },
  "keywords": [
    "playwright",
    "api",
    "testing",
    "addressbook"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "http-status-codes": "^2.3.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
