@page "/contacts"
@using AddressBook.Contracts.Models;

<PageTitle>Contacts</PageTitle>

<MudMessageBox @ref="_confirmDeleteMessageBox" Title="Warning" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to delete this contact?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" data-testid="contact-delete-confirm">Yes</MudButton>
    </YesButton>
</MudMessageBox>

<MudGrid>
    <MudItem xs="3">
        <MudText Typo="Typo.h6">Contacts</MudText>
    </MudItem>
    <MudItem xs="9" />

    <MudItem xs="12">
        <MudTable ServerData="ServerReload" Dense="true" Hover="true" @ref="_contactTable" data-testid="contacts-table">
            <ToolBarContent>
                <MudButton Variant="Variant.Outlined" OnClick="ShowCreateContactForm" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" data-testid="contacts-create">Create Contact</MudButton>
                <MudSpacer />
                <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"
                    Clearable="true" data-testid="contacts-search"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="fn_field" T="ContactModel">First Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="ln_field" T="ContactModel">Last Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="bd_field" T="ContactModel">Birthday</MudTableSortLabel></MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="First Name" data-testid="@($"contact-row-{context.Id}")">@context.FirstName</MudTd>
                <MudTd DataLabel="Last Name">@context.LastName</MudTd>
                <MudTd DataLabel="Birthday">@context.Birthday?.ToShortDateString()</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Filled" OnClick="@(_ => Navigation.NavigateTo($"/edit-contact/{context.Id}"))" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" aria-label="Edit contact" data-testid="@($"contact-edit-{context.Id}")"></MudButton>
                    <MudButton Variant="Variant.Filled" OnClick="@(_ => DeleteContactAsync(context.Id))" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Class="ms-2" aria-label="Delete contact" data-testid="@($"contact-delete-{context.Id}")"></MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>"No matching records found"</MudText>
                <MudSpacer />
                <MudAlert Class="@ErrorVisibility" Severity="Severity.Error">@_errorText</MudAlert>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>
            <PagerContent>
                @* MudTablePager's built-in rows-per-page <MudSelect> renders a role="combobox" with no
                   accessible name and exposes no parameter to set one (MudBlazor 9.7.0/9.8.0/dev — see
                   docs/tasks/issue-136-a11y-pager-rows-per-page-name.md). Hide it and supply our own
                   labeled select so the control keeps working AND has an accessible name (axe
                   aria-input-field-name). MudBlazor-only, no JS. Keep the mud-table-pagination-select
                   class so the stock styling and the UI-test locator still apply. *@
                <div class="d-flex align-center justify-end flex-grow-1 flex-wrap">
                    <MudText Typo="Typo.body2" Class="mud-table-pagination-caption mr-2">Rows per page:</MudText>
                    <MudSelect T="int" Value="_rowsPerPage" ValueChanged="OnRowsPerPageChanged" Dense="true"
                        Underline="false" aria-label="Rows per page" Class="mud-table-pagination-select">
                        @foreach (var size in PageSizeOptions)
                        {
                            <MudSelectItem T="int" Value="@size">@size</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTablePager HideRowsPerPage="true" />
                </div>
            </PagerContent>
        </MudTable>
    </MudItem>
</MudGrid>