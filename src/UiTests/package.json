{
  "name": "addressbook-ui-tests",
  "version": "1.0.0",
  "description": "Modern UI (E2E) test framework for AddressBook.Web (Playwright + TypeScript)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright test && playwright show-report",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:remote": "cross-env BASE_URL=https://happy-river-0d4a91803-preview.westeurope.6.azurestaticapps.net/ playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\""
  },
  "keywords": [
    "playwright",
    "ui",
    "e2e",
    "blazor",
    "testing",
    "addressbook"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.12.0",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
