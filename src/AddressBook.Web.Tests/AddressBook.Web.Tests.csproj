<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Component (bUnit) tests for AddressBook.Web: in-memory rendering of Blazor components,
    without a browser/API/DB. Runner is xUnit v3 (requires OutputType=Exe). MudBlazor comes
    transitively via the ProjectReference to AddressBook.Web, so no separate PackageReference is duplicated.
    Full design: docs/tasks/blazor-component-tests-framework-plan.md
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The XML doc file is generated for every project (Directory.Build.props); XML comments are not mandatory here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    xUnit v3 runs natively on Microsoft.Testing.Platform (MTP) and does NOT use VSTest packages:
    (Microsoft.NET.Test.Sdk / xunit.runner.visualstudio / coverlet.collector / *TestLogger) —
    the classic VSTest path was removed in the .NET 10 SDK. MTP mode for `dotnet test` is enabled via
    global.json (test.runner section) at the repo root. MTP extensions for coverage and
    the CI report will be added by task B20 (CI).
  -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="bunit" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Bogus" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AddressBook.Web\AddressBook.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
